types  acs_filter_trait_leveled_group_types {
	type acs_filter_trait_leveled_group = acs_vbox_filter_group {
		name = "acs_filter_trait_leveled"

		blockoverride "acs_vbox_filter_group_name" {
			text = "acs_filter_trait_group_leveled_traits"
		}

		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_trait_leveled' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_trait_leveled' ) ), '(int32)1', '(int32)2' )]"
		}

		blockoverride "acs_filter_visible" {
			visible = "[GetVariableSystem.Exists( 'acs_filter_trait_leveled' )]"
		}

		blockoverride "acs_filters" {
			flowcontainer = {
				direction = vertical
				spacing = 8

				# Scarred
				flowcontainer = {
					direction = vertical
					spacing = 2

					acs_trait_item_custom_center = {
						datacontext = "[GetScriptedGui( 'acs_filter_simple_checkbox' )]"
						blockoverride "acs_trait_item_action" {
							datacontext = "[GetTrait( 'scarred' )]"
							onclick = "[ScriptedGui.Execute( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)3300' ) ).End )]"
						}
						blockoverride "acs_checkbox_state" {
							frame = "[Select_int32( ScriptedGui.IsShown( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)3300' ) ).End ) , '(int32)2' ,  Select_int32( ScriptedGui.IsShown( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)2' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)3300' ) ).End ) , '(int32)3' , '(int32)1' ) )]"
						}
						blockoverride "acs_filter_name" {
							text = "trait_scarred"
						}
						blockoverride "acs_custom_image" {
							texture = "gfx/interface/icons/traits/scarred.dds"
						}
					}

					flowcontainer = {
						direction = horizontal
