types  acs_filter_camp_positions_group_types {
	type acs_filter_camp_positions_group = acs_vbox_filter_group {
		name = "acs_filter_camp_positions"
		
		blockoverride "acs_vbox_filter_group_name" {
			text = "acs_filter_group_camp_positions"
		}
		
		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_camp_positions' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_camp_positions' ) ), '(int32)1', '(int32)2' )]"
		}
		
		blockoverride "acs_filter_visible" {
			visible = "[GetVariableSystem.Exists( 'acs_filter_camp_positions' )]"
		}
		
		blockoverride "acs_filters" {
			# Row 1
			flowcontainer = {
				acs_trait_item_custom_left = {
					datacontext = "[GetScriptedGui( 'acs_filter_simple_checkbox' )]"
					blockoverride "acs_trait_item_action" {
						onclick = "[ScriptedGui.Execute( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)1700' ) ).End )]"
					}
					blockoverride "acs_checkbox_state" {
						frame = "[Select_int32( ScriptedGui.IsShown( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)1700' ) ).End ) , '(int32)2' ,  Select_int32( ScriptedGui.IsShown( GuiScope.AddScope( 'ctrl_value', MakeScopeValue( '(CFixedPoint)2' ) ).AddScope( 'position' , MakeScopeValue( '(CFixedPoint)1700' ) ).End ) , '(int32)3' , '(int32)1' ) )]"
					}
