types  acs_filter_council_positions_group_types {
	type acs_filter_council_positions_group = acs_vbox_filter_group {
		name = "acs_filter_council_positions"
		
		blockoverride "acs_vbox_filter_group_name" {
			text = "acs_filter_group_council_positions"
		}
		
		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_council_positions' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_council_positions' ) ), '(int32)1', '(int32)2' )]"
		}
		
		blockoverride "acs_filter_visible" {
			visible = "[GetVariableSystem.Exists( 'acs_filter_council_positions' )]"
		}
		
		blockoverride "acs_filters" {
			# Council Header
			flowcontainer = {
