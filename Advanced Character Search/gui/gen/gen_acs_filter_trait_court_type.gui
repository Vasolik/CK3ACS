		}
		
		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_trait_court_life' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_trait_court_life' ) ), '(int32)1', '(int32)2' )]"
		}
		
		blockoverride "acs_filter_visible" {
