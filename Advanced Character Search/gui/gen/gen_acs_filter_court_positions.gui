types  acs_filter_court_positions_group_types {
	type acs_filter_court_positions_group = acs_vbox_filter_group {
		name = "acs_filter_court_positions"
		
		blockoverride "acs_vbox_filter_group_name" {
			text = "acs_filter_group_court_positions"
		}
		
		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_court_positions' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_court_positions' ) ), '(int32)1', '(int32)2' )]"
		}
		
		blockoverride "acs_filter_visible" {
			visible = "[GetVariableSystem.Exists( 'acs_filter_court_positions' )]"
		}
		
		blockoverride "acs_filters" {
			# Row 1
			flowcontainer = {
				acs_trait_item_custom_left = {
					datacontext = "[GetScriptedGui( 'acs_filter_simple_checkbox' )]"
