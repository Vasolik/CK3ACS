types acs_filter_dropdown_resources_balance_types {
	type acs_filter_dropdown_resources_balance_group = acs_vbox_filter_group {
		name = "acs_filter_resources_balance"

		blockoverride "acs_vbox_filter_group_name" {
			text = "acs_filter_group_resources_balance"
		}
		blockoverride "acs_vbox_filter_group_toggle" {
			onclick = "[GetVariableSystem.Toggle( 'acs_filter_resources_balance' )]"
			frame = "[Select_int32( Not( GetVariableSystem.Exists( 'acs_filter_resources_balance' ) ), '(int32)1', '(int32)2' )]"
		}
		blockoverride "acs_filter_visible" {
			visible = "[GetVariableSystem.Exists( 'acs_filter_resources_balance' )]"
